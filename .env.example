# SMTP Configuration (para envío automático de emails)
# Ejemplos de configuración para diferentes proveedores:
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu-email@gmail.com
#   SMTP_PASS=tu-app-password  ← genera una contraseña de aplicación en Google
#
# Outlook/Office 365:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu-email@outlook.com
#   SMTP_PASS=tu-password
#
# Servidor propio / otros proveedores:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Email donde se reciben los formularios enviados
SMTP_TO_EMAIL=castilla@joaquincastilla.com
